# i3 config file (v4)
# kali-clean — i3
# Pebl3-style: near-black, 1px square borders, small gaps, white focus border.
# Mod = Super. No compositor: picom caused Thunar/GTK repaint corruption in VMware.

set $mod Mod4
set $term /usr/bin/env bash ~/.config/i3/scripts/open-terminal-cwd.sh
set $menu rofi -show drun

font pango:JetBrains Mono 10

# ---------------------------------------------------------------- look
default_border pixel 1
default_floating_border pixel 1
for_window [class=".*"] border pixel 1
hide_edge_borders none
gaps inner 4
gaps outer 2
smart_gaps off
title_align left

#                       border  bg      text    indicator child_border
client.focused          #ffffff #0a0a0a #f5f5f5 #ffffff   #ffffff
client.focused_inactive #1f1f1f #0a0a0a #71717a #1f1f1f   #1f1f1f
client.unfocused        #1f1f1f #060606 #52525b #1f1f1f   #1f1f1f
client.urgent           #ef4444 #7a2e2e #ffffff #ef4444   #ef4444
client.placeholder      #1f1f1f #060606 #52525b #1f1f1f   #1f1f1f
client.background       #060606

# ---------------------------------------------------------------- behaviour
focus_follows_mouse no
mouse_warping none
workspace_auto_back_and_forth yes
popup_during_fullscreen smart
focus_on_window_activation smart
floating_modifier $mod

# xct / Pebl3 directional keys (arrows work too).
set $left  j
set $down  k
set $up    l
set $right semicolon

# ---------------------------------------------------------------- apps
bindsym $mod+Return exec --no-startup-id $term
bindsym $mod+d exec --no-startup-id $menu
bindsym $mod+Shift+f exec --no-startup-id firefox-esr
bindsym $mod+Shift+n exec --no-startup-id thunar
bindsym $mod+Shift+b exec --no-startup-id /usr/bin/env bash ~/.config/i3/scripts/wallpaper-menu.sh
bindsym $mod+Shift+p exec --no-startup-id flameshot gui
bindsym Print exec --no-startup-id flameshot gui
bindsym Shift+Print exec --no-startup-id flameshot full -p ~/Pictures/Screenshots
bindsym $mod+Shift+x exec --no-startup-id /usr/bin/env bash ~/.config/i3/scripts/lock.sh

# ---------------------------------------------------------------- windows
bindsym $mod+Shift+q kill

bindsym $mod+$left  focus left
bindsym $mod+$down  focus down
bindsym $mod+$up    focus up
bindsym $mod+$right focus right
bindsym $mod+Left   focus left
bindsym $mod+Down   focus down
bindsym $mod+Up     focus up
bindsym $mod+Right  focus right

bindsym $mod+Shift+$left  move left
bindsym $mod+Shift+$down  move down
bindsym $mod+Shift+$up    move up
bindsym $mod+Shift+$right move right
bindsym $mod+Shift+Left   move left
bindsym $mod+Shift+Down   move down
bindsym $mod+Shift+Up     move up
bindsym $mod+Shift+Right  move right

bindsym $mod+h split h
bindsym $mod+v split v
bindsym $mod+f fullscreen toggle
bindsym $mod+s layout stacking
bindsym $mod+w layout tabbed
bindsym $mod+e layout toggle split
bindsym $mod+Shift+space floating toggle
bindsym $mod+space focus mode_toggle
bindsym $mod+a focus parent

bindsym $mod+Shift+minus move scratchpad
bindsym $mod+minus scratchpad show

# ---------------------------------------------------------------- workspaces
set $ws1 1
set $ws2 2
set $ws3 3
set $ws4 4
set $ws5 5
set $ws6 6
set $ws7 7
set $ws8 8
set $ws9 9
set $ws10 10

bindsym $mod+1 workspace number $ws1
bindsym $mod+2 workspace number $ws2
bindsym $mod+3 workspace number $ws3
bindsym $mod+4 workspace number $ws4
bindsym $mod+5 workspace number $ws5
bindsym $mod+6 workspace number $ws6
bindsym $mod+7 workspace number $ws7
bindsym $mod+8 workspace number $ws8
bindsym $mod+9 workspace number $ws9
bindsym $mod+0 workspace number $ws10

bindsym $mod+Shift+1 move container to workspace number $ws1
bindsym $mod+Shift+2 move container to workspace number $ws2
bindsym $mod+Shift+3 move container to workspace number $ws3
bindsym $mod+Shift+4 move container to workspace number $ws4
bindsym $mod+Shift+5 move container to workspace number $ws5
bindsym $mod+Shift+6 move container to workspace number $ws6
bindsym $mod+Shift+7 move container to workspace number $ws7
bindsym $mod+Shift+8 move container to workspace number $ws8
bindsym $mod+Shift+9 move container to workspace number $ws9
bindsym $mod+Shift+0 move container to workspace number $ws10

# ---------------------------------------------------------------- resize
set $mode_resize resize  j/k/l/; or arrows  ·  Enter/Esc to finish
mode "$mode_resize" {
    bindsym $left  resize shrink width  10 px or 10 ppt
    bindsym $down  resize grow   height 10 px or 10 ppt
    bindsym $up    resize shrink height 10 px or 10 ppt
    bindsym $right resize grow   width  10 px or 10 ppt
    bindsym Left   resize shrink width  10 px or 10 ppt
    bindsym Down   resize grow   height 10 px or 10 ppt
    bindsym Up     resize shrink height 10 px or 10 ppt
    bindsym Right  resize grow   width  10 px or 10 ppt
    bindsym Return mode "default"
    bindsym Escape mode "default"
}
bindsym $mod+r mode "$mode_resize"

# ---------------------------------------------------------------- session
bindsym $mod+Shift+c reload
bindsym $mod+Shift+r restart
bindsym $mod+Shift+e exec --no-startup-id i3-nagbar -t warning -m 'Exit i3 and end this session?' -B 'Exit' 'i3-msg exit'

# ---------------------------------------------------------------- media keys
bindsym XF86AudioRaiseVolume exec --no-startup-id pactl set-sink-volume @DEFAULT_SINK@ +5%
bindsym XF86AudioLowerVolume exec --no-startup-id pactl set-sink-volume @DEFAULT_SINK@ -5%
bindsym XF86AudioMute exec --no-startup-id pactl set-sink-mute @DEFAULT_SINK@ toggle
bindsym XF86AudioMicMute exec --no-startup-id pactl set-source-mute @DEFAULT_SOURCE@ toggle
bindsym XF86AudioPlay exec --no-startup-id playerctl play-pause
bindsym XF86AudioNext exec --no-startup-id playerctl next
bindsym XF86AudioPrev exec --no-startup-id playerctl previous
bindsym XF86MonBrightnessUp exec --no-startup-id brightnessctl set +5%
bindsym XF86MonBrightnessDown exec --no-startup-id brightnessctl set 5%-

# ---------------------------------------------------------------- rules
for_window [window_type="dialog"] floating enable
for_window [window_role="pop-up"] floating enable
for_window [class="^(Pavucontrol|Nm-connection-editor|Lxappearance|Arandr|Blueman-manager|flameshot)$"] floating enable

# ---------------------------------------------------------------- startup
exec_always --no-startup-id /usr/bin/env bash ~/.config/i3/scripts/set-wallpaper.sh
# Never blank the screen in the middle of a long scan or an exam session.
exec --no-startup-id xset s off -dpms
exec --no-startup-id sh -c 'pkill -x dunst 2>/dev/null; exec dunst'
exec --no-startup-id nm-applet
exec --no-startup-id sh -c 'command -v lxpolkit >/dev/null 2>&1 && exec lxpolkit'
# VMware host/guest clipboard + drag/drop; plain i3 does not start it.
exec --no-startup-id sh -c 'command -v vmware-user-suid-wrapper >/dev/null 2>&1 && exec vmware-user-suid-wrapper'
# VMware dynamic resolution: follow the window size ("Autofit Guest"). Kali's X
# driver leaves that to the desktop and i3 does not do it. One instance per
# display, so reloads are safe; it exits at once outside a VM.
exec_always --no-startup-id exec /usr/bin/env python3 ~/.config/i3/scripts/vm-autofit.py
# Hide an idle pointer so it never lands in a screenshot.
exec --no-startup-id unclutter -idle 2 -root
exec --no-startup-id xsetroot -cursor_name left_ptr

# ---------------------------------------------------------------- bar
bar {
    position top
    mode dock
    height 28
    workspace_buttons yes
    strip_workspace_numbers yes
    workspace_min_width 28
    binding_mode_indicator yes
    tray_output primary
    tray_padding 4
    font pango:JetBrains Mono 10
    status_command /usr/bin/python3 ~/.config/i3/status.py

    colors {
        background #0a0a0a
        statusline #a1a1aa
        separator  #1f1f1f
        #                  border  bg      text
        focused_workspace  #3f3f46 #1f1f1f #ffffff
        active_workspace   #1f1f1f #0a0a0a #a1a1aa
        inactive_workspace #0a0a0a #0a0a0a #71717a
        urgent_workspace   #ef4444 #7a2e2e #ffffff
        binding_mode       #ef4444 #7a2e2e #ffffff
    }
}
