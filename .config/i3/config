# kali-clean — i3 configuration
# Flat near-black desktop inspired by xct/kali-clean and Pebl3/kali-clean.

set $mod Mod4
set $term /usr/bin/env bash ~/.config/i3/scripts/open-terminal-cwd.sh
set $menu rofi -show drun

# Palette
set $bg       #0b0b0b
set $bg_alt   #141414
set $border   #303030
set $border_2 #222222
set $fg       #c8c8c8
set $fg_dim   #6f6f6f
set $urgent   #6b2b2b

font pango:Geist Mono 10

default_border pixel 1
default_floating_border pixel 1
hide_edge_borders none
gaps inner 6
gaps outer 0
smart_gaps on

focus_follows_mouse no
mouse_warping none
workspace_auto_back_and_forth yes
popup_during_fullscreen smart
focus_on_window_activation smart
floating_modifier $mod

# border / background / text / indicator / child border
client.focused          $border   $bg      #eeeeee  $border   $border
client.focused_inactive $border_2 $bg      $fg      $border_2 $border_2
client.unfocused        $border_2 $bg      $fg_dim  $border_2 $border_2
client.urgent           $urgent   $urgent  #ffffff  $urgent   $urgent
client.placeholder      $border_2 $bg      $fg_dim  $border_2 $border_2
client.background       $bg

# xct/Pebl3-style directional keys.
set $left  j
set $down  k
set $up    l
set $right semicolon

# Applications.
bindsym $mod+Return exec --no-startup-id $term
bindsym $mod+d exec --no-startup-id $menu
bindsym $mod+Shift+f exec --no-startup-id firefox-esr
bindsym $mod+Shift+p exec --no-startup-id flameshot gui
bindsym Print exec --no-startup-id flameshot gui
bindsym $mod+Shift+b exec --no-startup-id /usr/bin/env bash ~/.config/i3/scripts/wallpaper-menu.sh
bindsym $mod+Shift+n exec --no-startup-id thunar

# Window management.
bindsym $mod+Shift+q kill
bindsym $mod+$left focus left
bindsym $mod+$down focus down
bindsym $mod+$up focus up
bindsym $mod+$right focus right
bindsym $mod+Left focus left
bindsym $mod+Down focus down
bindsym $mod+Up focus up
bindsym $mod+Right focus right

bindsym $mod+Shift+$left move left
bindsym $mod+Shift+$down move down
bindsym $mod+Shift+$up move up
bindsym $mod+Shift+$right move right
bindsym $mod+Shift+Left move left
bindsym $mod+Shift+Down move down
bindsym $mod+Shift+Up move up
bindsym $mod+Shift+Right move right

bindsym $mod+h split h
bindsym $mod+v split v
bindsym $mod+f fullscreen toggle
bindsym $mod+s layout stacking
bindsym $mod+w layout tabbed
bindsym $mod+e layout toggle split
bindsym $mod+Shift+space floating toggle
bindsym $mod+space focus mode_toggle
bindsym $mod+a focus parent

# Scratchpad.
bindsym $mod+Shift+minus move scratchpad
bindsym $mod+minus scratchpad show

# Workspaces.
set $ws1 1
set $ws2 2
set $ws3 3
set $ws4 4
set $ws5 5
set $ws6 6
set $ws7 7
set $ws8 8
set $ws9 9
set $ws10 10

bindsym $mod+1 workspace number $ws1
bindsym $mod+2 workspace number $ws2
bindsym $mod+3 workspace number $ws3
bindsym $mod+4 workspace number $ws4
bindsym $mod+5 workspace number $ws5
bindsym $mod+6 workspace number $ws6
bindsym $mod+7 workspace number $ws7
bindsym $mod+8 workspace number $ws8
bindsym $mod+9 workspace number $ws9
bindsym $mod+0 workspace number $ws10

bindsym $mod+Shift+1 move container to workspace number $ws1
bindsym $mod+Shift+2 move container to workspace number $ws2
bindsym $mod+Shift+3 move container to workspace number $ws3
bindsym $mod+Shift+4 move container to workspace number $ws4
bindsym $mod+Shift+5 move container to workspace number $ws5
bindsym $mod+Shift+6 move container to workspace number $ws6
bindsym $mod+Shift+7 move container to workspace number $ws7
bindsym $mod+Shift+8 move container to workspace number $ws8
bindsym $mod+Shift+9 move container to workspace number $ws9
bindsym $mod+Shift+0 move container to workspace number $ws10

# Resize mode.
set $mode_resize resize: j/k/l/; or arrows · Enter/Esc to finish
mode "$mode_resize" {
    bindsym $left  resize shrink width  10 px or 10 ppt
    bindsym $down  resize grow   height 10 px or 10 ppt
    bindsym $up    resize shrink height 10 px or 10 ppt
    bindsym $right resize grow   width  10 px or 10 ppt
    bindsym Left   resize shrink width  10 px or 10 ppt
    bindsym Down   resize grow   height 10 px or 10 ppt
    bindsym Up     resize shrink height 10 px or 10 ppt
    bindsym Right  resize grow   width  10 px or 10 ppt
    bindsym Return mode "default"
    bindsym Escape mode "default"
}
bindsym $mod+r mode "$mode_resize"

# Session controls.
bindsym $mod+Shift+c reload
bindsym $mod+Shift+r restart
bindsym $mod+Shift+e exec --no-startup-id i3-nagbar -t warning -m 'Exit i3 and end this session?' -B 'Exit' 'i3-msg exit'
bindsym $mod+Shift+x exec --no-startup-id i3lock -c 0b0b0b

# Media / brightness.
bindsym XF86AudioRaiseVolume exec --no-startup-id pactl set-sink-volume @DEFAULT_SINK@ +5%
bindsym XF86AudioLowerVolume exec --no-startup-id pactl set-sink-volume @DEFAULT_SINK@ -5%
bindsym XF86AudioMute exec --no-startup-id pactl set-sink-mute @DEFAULT_SINK@ toggle
bindsym XF86AudioMicMute exec --no-startup-id pactl set-source-mute @DEFAULT_SOURCE@ toggle
bindsym XF86AudioPlay exec --no-startup-id playerctl play-pause
bindsym XF86AudioNext exec --no-startup-id playerctl next
bindsym XF86AudioPrev exec --no-startup-id playerctl previous
bindsym XF86MonBrightnessUp exec --no-startup-id brightnessctl set +5%
bindsym XF86MonBrightnessDown exec --no-startup-id brightnessctl set 5%-

# Dialogs/control panels float; ordinary applications tile.
for_window [window_type="dialog"] floating enable
for_window [class="^(Pavucontrol|Nm-connection-editor|Lxappearance|Arandr|Blueman-manager)$"] floating enable

# Startup. The wallpaper/status commands are invoked through their interpreters,
# so repository executable-bit loss cannot break the desktop.
exec_always --no-startup-id /usr/bin/env bash ~/.config/i3/scripts/set-wallpaper.sh
exec --no-startup-id picom --config ~/.config/picom/picom.conf --daemon
exec --no-startup-id dunst
exec --no-startup-id nm-applet
exec --no-startup-id sh -c 'command -v blueman-applet >/dev/null 2>&1 && blueman-applet'
exec --no-startup-id sh -c 'command -v lxpolkit >/dev/null 2>&1 && exec lxpolkit'
exec --no-startup-id unclutter -idle 4
exec --no-startup-id xsetroot -cursor_name left_ptr

# Pebl3-inspired compact top bar. The status process is shipped with this repo,
# so the bar has no dependency on distro-specific block-script directories.
bar {
    position top
    mode dock
    workspace_buttons yes
    binding_mode_indicator yes
    strip_workspace_numbers no
    tray_output primary
    tray_padding 2
    font pango:Geist Mono 10
    status_command /usr/bin/python3 ~/.config/i3/status.py

    colors {
        background         $bg
        statusline         $fg
        separator          #262626
        focused_workspace  #444444 #444444 #f2f2f2
        active_workspace   #202020 #202020 #cfcfcf
        inactive_workspace $bg     $bg     #666666
        urgent_workspace   $urgent $urgent #ffffff
        binding_mode       #333333 #333333 #f2f2f2
    }
}
