configuration {
    modes: [ drun, run, window ];
    font: "Geist Mono 11";
    show-icons: true;
    icon-theme: "Papirus-Dark";
    drun-display-format: "{name}";
    display-drun: "apps";
    display-run: "run";
    display-window: "windows";
}

* {
    bg: #0b0b0b;
    bg-alt: #171717;
    border: #303030;
    fg: #c8c8c8;
    fg-dim: #707070;
    selected: #2a2a2a;
    background-color: transparent;
    text-color: @fg;
}

window {
    width: 38%;
    border: 1px;
    border-color: @border;
    border-radius: 0px;
    background-color: @bg;
    padding: 12px;
}

mainbox {
    spacing: 8px;
    children: [ inputbar, listview ];
}

inputbar {
    background-color: @bg-alt;
    border: 0px;
    border-radius: 0px;
    padding: 9px 11px;
    children: [ prompt, entry ];
}

prompt {
    text-color: @fg-dim;
    padding: 0px 10px 0px 0px;
}

entry {
    text-color: @fg;
    placeholder: "type to search";
    placeholder-color: @fg-dim;
}

listview {
    lines: 8;
    columns: 1;
    fixed-height: false;
    scrollbar: false;
    spacing: 2px;
}

element {
    padding: 8px 10px;
    border-radius: 0px;
}

element selected {
    background-color: @selected;
}

element-icon {
    size: 20px;
    margin: 0px 9px 0px 0px;
}

element-text {
    vertical-align: 0.5;
}
