configuration {
    font: "Geist Mono 11";
    show-icons: true;
    icon-theme: "Papirus-Dark";
    drun-display-format: "{name}";
}
* {
    bg: #08090b;
    surface: #101216;
    border: #2a2f37;
    fg: #d8dce2;
    dim: #6f7680;
    accent: #d8dce2;
    selected-fg: #08090b;
    background-color: transparent;
    text-color: @fg;
}
window {
    width: 36%;
    border: 1px;
    border-color: @border;
    border-radius: 0px;
    background-color: @bg;
    padding: 14px;
}
mainbox { spacing: 10px; children: [ inputbar, listview ]; }
inputbar {
    background-color: @surface;
    border: 1px;
    border-color: @border;
    border-radius: 0px;
    padding: 10px 12px;
    children: [ prompt, entry ];
}
prompt { text-color: @dim; padding: 0px 12px 0px 0px; }
entry { text-color: @fg; placeholder: "type to search"; placeholder-color: @dim; }
listview { lines: 9; columns: 1; fixed-height: false; scrollbar: false; spacing: 3px; }
element { padding: 9px 11px; border: 0px; border-radius: 0px; background-color: transparent; text-color: @fg; }
element selected { background-color: @accent; text-color: @selected-fg; }
element-icon { size: 20px; margin: 0px 10px 0px 0px; background-color: transparent; }
element-text { vertical-align: 0.5; background-color: transparent; text-color: inherit; }
