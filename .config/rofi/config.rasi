/* kali-clean — Rofi (Mod+d)
 * Pebl3 "contour" styling: near-black box, grayscale list, the selected row
 * gets a white edge marker. Fully opaque. */

configuration {
    modi: "drun,run,window";
    show-icons: true;
    icon-theme: "Papirus-Dark";
    drun-display-format: "{name}";
    display-drun: "apps";
    display-run: "run";
    display-window: "windows";
    font: "JetBrains Mono 11";
    matching: "fuzzy";
    sort: true;
    sorting-method: "fzf";
}

/* Start from an empty theme so none of rofi's built-in (light) colours leak in. */
@theme "/dev/null"

* {
    ground:       #060606;
    surface:      #0a0a0a;
    hairline:     #1f1f1f;
    text-dim:     #52525b;
    text-label:   #71717a;
    text-2nd:     #a1a1aa;
    text-primary: #f5f5f5;
    focus:        #ffffff;

    background-color: transparent;
    text-color:       @text-primary;
}

window {
    location:         center;
    width:            640px;
    background-color: @surface;
    border:           1px;
    border-color:     @hairline;
    border-radius:    0px;
    padding:          8px;
}

mainbox {
    spacing:  8px;
    children: [ inputbar, listview ];
}

inputbar {
    background-color: @ground;
    border:           0px 0px 1px 0px;
    border-color:     @hairline;
    padding:          10px 12px;
    spacing:          12px;
    children:         [ prompt, entry ];
}

prompt {
    text-color: @text-label;
}

entry {
    text-color:        @text-primary;
    placeholder:       "search";
    placeholder-color: @text-dim;
}

listview {
    lines:        10;
    columns:      1;
    spacing:      2px;
    fixed-height: false;
    scrollbar:    false;
}

element {
    padding:          7px 10px;
    spacing:          10px;
    border:           0px 0px 0px 2px;
    border-color:     transparent;
    border-radius:    0px;
    background-color: transparent;
    text-color:       @text-2nd;
}

element selected {
    background-color: @hairline;
    border-color:     @focus;
    text-color:       @focus;
}

element-icon {
    size:             18px;
    background-color: transparent;
}

element-text {
    vertical-align:   0.5;
    background-color: transparent;
    text-color:       inherit;
    highlight:        bold;
}

message {
    padding:          8px 12px;
    background-color: @ground;
}

textbox {
    text-color: @text-2nd;
}
