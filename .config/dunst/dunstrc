# kali-clean — Dunst notifications (near-black, 1px hairline, square).

[global]
    monitor = 0
    follow = mouse
    width = 360
    height = 140
    origin = top-right
    offset = 12x40
    notification_limit = 5
    progress_bar = true
    progress_bar_height = 4
    progress_bar_frame_width = 0
    progress_bar_min_width = 160
    progress_bar_max_width = 336
    transparency = 0
    separator_height = 1
    padding = 10
    horizontal_padding = 12
    text_icon_padding = 10
    frame_width = 1
    frame_color = "#1f1f1f"
    separator_color = frame
    font = JetBrains Mono 10
    line_height = 2
    markup = full
    format = "<b>%s</b>\n%b"
    alignment = left
    vertical_alignment = center
    word_wrap = yes
    ellipsize = middle
    icon_position = left
    max_icon_size = 28
    history_length = 30
    browser = /usr/bin/xdg-open
    corner_radius = 0
    mouse_left_click = close_current
    mouse_middle_click = do_action, close_current
    mouse_right_click = close_all

[urgency_low]
    background = "#0a0a0a"
    foreground = "#a1a1aa"
    frame_color = "#1f1f1f"
    timeout = 4

[urgency_normal]
    background = "#0a0a0a"
    foreground = "#f5f5f5"
    frame_color = "#3f3f46"
    timeout = 6

[urgency_critical]
    background = "#1a0b0b"
    foreground = "#ffffff"
    frame_color = "#ef4444"
    timeout = 0
